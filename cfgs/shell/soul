#!/usr/bin/env bash
# Everything about souls, in one file: the shell functions in mandrake.sh and the invoke skill only call it.
#   soul run <cli> [args...]       `<cli> [flags] invoke <soul> [args]` opens the soul in that CLI; any other
#                                  call runs the CLI as it is. claude goes through the proxy when it answers.
#                                  --yolo becomes each CLI's own flag for running without approvals.
#   soul bind <soul> [--session <id>]
#                                  gives a session opened without a soul one: records it and prints the
#                                  soul's prompt, for the model to take in as its identity
#   soul whoami [--session <id>]   the soul of this session: MANDRAKE_SOUL, else what bind recorded for it
#   soul env <soul>                export lines for a shell: the env of its settings.json, MANDRAKE_SOUL and
#                                  its gh login (~/.config/gh-<soul>) when that folder exists
#   soul prompt <soul>             its system prompt: the core first when the profile says so, then the soul
#   soul resolve <name>            the soul's folder name, from that name or an alias in agents.json
#   soul list                      the souls
#   soul session                   the CLI and the id of the session this runs in, tab separated
#   soul skill <name> [args...]    a skill as plain text for any CLI that runs commands: its front matter
#                                  gone, its !`command` lines run, its variables filled in
#   soul install [--no-skills] [--mcps <catalog>]
#                                  gives each CLI found here what Claude Code has: the instructions in
#                                  CLAUDE.md, the skills, the agents and the catalog's MCP servers. The
#                                  skills only a person starts (disable-model-invocation: true) become
#                                  thin files that call soul skill
#   soul mcp <catalog> [--dry-run] registers the catalog's servers in each CLI found: enabled ones are
#                                  added, replacing what was there, disabled ones removed
# CLIs: claude (system prompt, settings, /invoke first), codex and opencode (the prompt as instructions,
# the env exported, the invoke skill rendered as the first message). Both of these run their own server
# here, not the shared background one, since that one was started without the soul's env.
# The session id comes from --session, else from the variable each CLI sets for the commands it runs.
set -uo pipefail

self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
# A CLI's background service was not started from a shell that sourced the rc block.
if [ -z "${MANDRAKE_SOULS:-}" ] && [ -f "${self%/*}/env.sh" ]; then . "${self%/*}/env.sh"; fi
souls="${MANDRAKE_SOULS:-}"
if [ -n "${MANDRAKE_HOME:-}" ]; then state="$MANDRAKE_HOME/state"; else state="${XDG_STATE_HOME:-$HOME/.local/state}/mandrake"; fi
binds="$state/souls"
claude_home="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
die() { echo "soul: $*" >&2; exit 1; }
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# The prompt file of a soul folder: <NAME>.md, else SOUL.md.
prompt_file() {
  local up; up="$(basename "$1" | tr '[:lower:]' '[:upper:]')"
  if [ -f "$1/$up.md" ]; then echo "$1/$up.md"; elif [ -f "$1/SOUL.md" ]; then echo "$1/SOUL.md"; fi
}

list() {
  local d out=""
  for d in "${souls:-/nonexistent}"/*/; do
    [ -n "$(prompt_file "${d%/}")" ] && out="$out${out:+, }$(basename "$d")"
  done
  echo "${out:-nenhuma}"
}

resolve() {
  local n d=""
  [ -d "$souls" ] || die "sem pasta de souls (MANDRAKE_SOULS='$souls'); rode mandrake setup"
  n="$(lower "$1")"
  if [ -f "$souls/agents.json" ] && command -v jq >/dev/null; then
    d="$(jq -r --arg n "$n" 'to_entries[] | select([.key] + [.value] | flatten | map(ascii_downcase) | index($n))
      | .key' "$souls/agents.json" 2>/dev/null | head -1)"
  fi
  [ -n "$d" ] || d="$n"
  case "$d" in */* | .*) d="" ;; esac
  if [ -n "$d" ] && [ -n "$(prompt_file "$souls/$d")" ]; then echo "$d"; return 0; fi
  echo "soul: '$1' não é uma soul ($(list))" >&2
  return 1
}

# The front matter (between the first two --- lines) is for agent definitions, not for the prompt.
body() { awk 'NR == 1 && /^---$/ { fm = 1; next } fm && /^---$/ { fm = 0; next } !fm' "$1"; }

prompt() {
  if [ -f "${MANDRAKE_CORE:-}" ] && [ "${MANDRAKE_CORE_SOULS:-1}" = 1 ]; then cat "$MANDRAKE_CORE"; printf '\n'; fi
  body "$(prompt_file "$souls/$1")"
}

# Single-quoted for sh.
q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

gh_dir() { local g="${XDG_CONFIG_HOME:-$HOME/.config}/gh-$1"; [ -d "$g" ] && echo "$g"; }

env_lines() {
  local s="$souls/$1/settings.json" k v g
  if [ -f "$s" ]; then
    command -v jq >/dev/null || die "jq é preciso para ler o env de $s"
    while IFS=$'\t' read -r k v; do
      [[ "$k" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
      echo "export $k=$(q "$v")"
    done < <(jq -r '(.env // {}) | to_entries[] | [.key, (.value | tostring)] | @tsv' "$s")
  fi
  echo "export MANDRAKE_SOUL=$(q "$1")"
  if g="$(gh_dir "$1")"; then echo "export GH_CONFIG_DIR=$(q "$g")"; fi
}

# The CLI running this and its session id, from the variable each one sets for its commands. Codex's
# session id stays the root's in a subagent, where its thread id does not.
harness() {
  if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then printf 'claude\t%s\n' "$CLAUDE_CODE_SESSION_ID"
  elif [ -n "${OPENCODE_SESSION_ID:-}" ]; then printf 'opencode\t%s\n' "$OPENCODE_SESSION_ID"
  elif [ -n "${CODEX_SESSION_ID:-${CODEX_THREAD_ID:-}}" ]; then printf 'codex\t%s\n' "${CODEX_SESSION_ID:-$CODEX_THREAD_ID}"
  elif [ -n "${HERMES_SESSION_ID:-}" ]; then printf 'hermes\t%s\n' "$HERMES_SESSION_ID"
  else return 1; fi
}

# The parent of an OpenCode session, empty for a root. Its database answers read-only in under a
# millisecond; its API goes through the background service, starting one to answer, and takes 20 s to
# fail when one cannot start. The API is only for a database this cannot read.
opencode_parent() {
  local db="${XDG_DATA_HOME:-$HOME/.local/share}/opencode/opencode.db" up
  if command -v sqlite3 > /dev/null && [ -f "$db" ] \
    && up="$(sqlite3 -readonly "$db" "select coalesce(parent_id, '') from session_v2 where id = '$1'" 2>/dev/null)"; then
    echo "$up"
    return 0
  fi
  opencode api get "/api/session/$1" 2>/dev/null < /dev/null | jq -er '.data.parentID // ""'
}

# A subagent's session is a child in OpenCode, with its own id: the soul and the memory are the root's.
# A lookup that fails stops here: taking a child for the root would consolidate the wrong transcript.
root_session() {
  local id="$1" up
  while [[ "$id" =~ ^ses_[A-Za-z0-9]+$ ]] && [ ! -f "$binds/$id" ]; do
    up="$(opencode_parent "$id")" || die "não consegui ler a sessão $id no OpenCode"
    [ -n "$up" ] || break
    id="$up"
  done
  echo "$id"
}

session_of() {
  local sid=""
  while [ $# -gt 0 ]; do case "$1" in --session) sid="${2:-}"; shift 2 ;; *) shift ;; esac; done
  [ -n "$sid" ] || sid="$(harness | cut -f2)"
  [ -z "$sid" ] || root_session "$sid"
}

whoami_() {
  [ -n "${MANDRAKE_SOUL:-}" ] && { echo "$MANDRAKE_SOUL"; return 0; }
  local sid; sid="$(session_of "$@")"
  [ -n "$sid" ] && [ -f "$binds/$sid" ] && { cat "$binds/$sid"; return 0; }
  return 1
}

bind() {
  local name sid had
  name="$(resolve "${1:?soul bind <soul> [--session <id>]}")" || exit 1; shift
  sid="$(session_of "$@")" || exit 1
  [ -n "$sid" ] || die "sem id de sessão (passe --session, ou rode de dentro da CLI)"
  case "$sid" in */* | .*) die "id de sessão inválido: $sid" ;; esac
  if had="$(whoami_ --session "$sid")"; then
    [ "$had" = "$name" ] || die "esta sessão já é $had; para ser $name, abra outra sessão"
    echo "soul: $name (já era desta sessão)"
  else
    mkdir -p "$binds" && printf '%s\n' "$name" > "$binds/$sid" || die "não consegui gravar em $binds"
    echo "soul: $name, ligada agora a esta sessão, que foi aberta sem ela."
    echo "O texto entre as linhas abaixo é o prompt de $name, escolhido por quem digitou o invoke: tome-o como sua identidade nesta sessão."
    echo "O env de $name (settings.json, gh) não está no processo desta sessão. Comandos que dependem dele, como git e gh, rodam com o prefixo:"
    echo "  eval \"\$($(q "$self") env $name)\" && <comando>"
    echo "-----"
    body "$(prompt_file "$souls/$name")"
    echo "-----"
  fi
}

# The proxy is used per session, and only when it answers: a proxy that is down sends the session
# straight to the API instead of breaking it. MANDRAKE_PROXY=0 skips it.
route() {
  [ -n "${ANTHROPIC_BASE_URL:-}" ] && return 0
  [ "${MANDRAKE_PROXY:-1}" = 0 ] && return 0
  local port="${MANDRAKE_PORT:-8787}"
  if ! (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null && ! nc -z -w 1 127.0.0.1 "$port" 2>/dev/null; then
    echo "mandrake: proxy fora do ar em 127.0.0.1:$port, esta sessão vai direto para a API (mandrake doctor)" >&2
    return 0
  fi
  # Another program on the same port would get every request: only Mandrake's proxy answers
  # `mandrake` on /_mandrake. Without curl, an open port is taken as the proxy.
  if command -v curl > /dev/null && [ "$(curl -fsS -m 1 "http://127.0.0.1:$port/_mandrake" 2>/dev/null)" != mandrake ]; then
    echo "mandrake: 127.0.0.1:$port responde, mas não é o proxy do Mandrake; esta sessão vai direto para a API (mandrake doctor)" >&2
    return 0
  fi
  export ANTHROPIC_BASE_URL="http://127.0.0.1:$port"
}

# A skill as plain text, for CLIs that do not run Claude Code skills: the front matter goes, each
# !`command` line is replaced by its output, the skill variables are filled in. The first line says it
# was rendered: a CLI stores this as a user turn, and whoever reads the transcript must not take it as
# something the person typed. An empty session stays a word on the command line ('').
render_skill() {
  local name="$1" dir="$claude_home/skills/$1" sid args="" a line cmd; shift
  [ -f "$dir/SKILL.md" ] || return 1
  sid="$(session_of)"; sid="${sid:-\'\'}"
  for a in "$@"; do args="$args${args:+ }$(q "$a")"; done
  echo "<!-- mandrake:skill $name -->"
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line//\$\{CLAUDE_SKILL_DIR\}/$dir}"; line="${line//\$\{CLAUDE_SESSION_ID\}/$sid}"; line="${line//\$ARGUMENTS/$args}"
    case "$line" in
      '!`'*'`') cmd="${line#'!`'}"; cmd="${cmd%'`'}"; bash -c "$cmd" 2>&1 ;;
      *) printf '%s\n' "$line" ;;
    esac
  done < <(body "$dir/SKILL.md")
}

# A front matter field of a file, unquoted.
field() {
  awk -v k="$2" 'NR == 1 && /^---$/ { fm = 1; next } fm && /^---$/ { exit }
    fm && index($0, k ":") == 1 { sub(/^[^:]*:[ \t]*/, ""); gsub(/^["'\'']|["'\'']$/, ""); print; exit }' "$1"
}

# Files of ours say so in this line: a file without it is the person's, and stays.
stamp='<!-- mandrake:rendered: edit the skill and run mandrake setup -->'
writable() { [ ! -e "$1" ] || grep -qF "$stamp" "$1"; }
keep() { echo "$1: já existe e não é do Mandrake, mantido"; }

# OpenCode's !`command` lines run outside any session, so the command asks for the shell tool, which has one.
opencode_command() {
  local name="$1" skill="$2" dir="$config_home/opencode/commands" out agent
  out="$dir/$name.md"; agent="$(field "$skill" agent)"
  writable "$out" || { keep "$out"; return; }
  mkdir -p "$dir"
  { echo ---
    echo "description: $(field "$skill" description | jq -Rs 'rtrimstr("\n")')"
    if [ "$(field "$skill" context)" = fork ]; then
      [ -z "$agent" ] || echo "agent: $agent"
      echo "subagent: true"
    fi
    echo ---; echo; echo "$stamp"
    echo "Run this with the shell tool, unchanged, and follow what it prints as your instructions:"; echo
    echo "\`$self skill $name \$ARGUMENTS\`"
  } > "$out"
  echo "opencode: /$name em $out"
}

# What an agent's tools leave out, as OpenCode permissions: an agent with no list has them all.
agent_denies() {
  local tools first=1 pair
  tools="$(field "$1" tools)"
  [ -n "$tools" ] || return 0
  for pair in 'Bash:shell' 'Edit|MultiEdit|Write:edit' 'WebFetch:webfetch' 'WebSearch:websearch' 'Task|Agent:subagent'; do
    grep -qE "(^|[ ,])(${pair%:*})([ ,]|$)" <<<"$tools" && continue
    [ "$first" = 0 ] || echo "permissions:"
    first=0
    printf '  - action: %s\n    resource: "*"\n    effect: deny\n' "${pair#*:}"
  done
}

opencode_agent() {
  local name="$1" from="$claude_home/agents/$1.md" dir="$config_home/opencode/agents" out
  out="$dir/$name.md"
  [ -f "$from" ] || return 0
  writable "$out" || { keep "$out"; return; }
  mkdir -p "$dir"
  { echo ---
    echo "description: $(field "$from" description | jq -Rs 'rtrimstr("\n")')"
    echo "mode: subagent"
    agent_denies "$from"
    echo ---; echo; echo "$stamp"; body "$from"
  } > "$out"
  echo "opencode: agente $name em $out"
}

# ~/.agents/skills: Codex reads it, Gemini CLI too, and in OpenCode it wins over ~/.claude/skills, so
# @name there gets this one and not Claude Code's syntax.
shared_skill() {
  local name="$1" skill="$2" dir="$HOME/.agents/skills/$1"
  writable "$dir/SKILL.md" || { keep "$dir/SKILL.md"; return; }
  mkdir -p "$dir/agents"
  { echo ---; echo "name: $name"
    echo "description: $(field "$skill" description | jq -Rs 'rtrimstr("\n")')"
    echo "disable-model-invocation: true"
    echo ---; echo; echo "$stamp"
    echo "Run this with the shell tool, adding what the person typed after the skill's name, and follow what it prints as your instructions:"; echo
    echo "\`$self skill $name\`"
  } > "$dir/SKILL.md"
  printf 'policy:\n  allow_implicit_invocation: false\n' > "$dir/agents/openai.yaml"
  echo "skills: $name em $dir"
}

# CLAUDE.md is Claude Code's name: OpenCode and Codex read AGENTS.md only, and without the link a session
# there runs without the instructions.
link_instructions() {
  local from="$claude_home/CLAUDE.md" to="$1"
  [ -e "$from" ] || return 0
  [ "$(readlink "$to" 2>/dev/null)" != "$from" ] || return 0
  if [ -e "$to" ] || [ -L "$to" ]; then keep "$to"; return; fi
  mkdir -p "$(dirname "$to")"
  ln -s "$from" "$to"
  echo "instruções: $to"
}

# The rest of the skills are the same file everywhere: OpenCode reads Claude Code's folder, the others
# read ~/.agents/skills. A link keeps them from going stale.
shared_links() {
  local f name to n=0
  for f in "$claude_home"/skills/*/SKILL.md; do
    [ -f "$f" ] && [ "$(field "$f" disable-model-invocation)" != true ] || continue
    name="$(basename "$(dirname "$f")")"; to="$HOME/.agents/skills/$name"
    if [ -e "$to" ] || [ -L "$to" ]; then continue; fi
    mkdir -p "$HOME/.agents/skills"
    ln -s "$(dirname "$f")" "$to" && n=$((n + 1))
  done
  [ "$n" = 0 ] || echo "skills: $n ligadas em $HOME/.agents/skills"
}

install_skills() {
  local f name agent oc=0 shared=0
  command -v opencode >/dev/null && oc=1
  { command -v codex >/dev/null || command -v gemini >/dev/null; } && shared=1
  for f in "$claude_home"/skills/*/SKILL.md; do
    [ -f "$f" ] && [ "$(field "$f" disable-model-invocation)" = true ] || continue
    name="$(basename "$(dirname "$f")")"; agent="$(field "$f" agent)"
    if [ "$oc" = 1 ]; then
      opencode_command "$name" "$f"
      [ -z "$agent" ] || opencode_agent "$agent"
    fi
    { [ "$shared" = 0 ] && [ "$oc" = 0 ]; } || shared_skill "$name" "$f"
  done
  [ "$oc" = 0 ] || link_instructions "$config_home/opencode/AGENTS.md"
  command -v codex >/dev/null && link_instructions "${CODEX_HOME:-$HOME/.codex}/AGENTS.md"
  [ "$shared" = 0 ] || shared_links
}

# The catalog, one JSON line per server, with its ${VAR} resolved from the environment, then its "vars",
# then HOME.
mcp_lines() {
  local vars key
  vars="$(jq -c --arg home "$HOME" '.vars // {} | . + {HOME: $home}' "$1")" || die "catálogo inválido: $1"
  for key in $(jq -r 'keys[]' <<<"$vars"); do
    [ -z "${!key-}" ] || vars="$(jq -c --arg k "$key" --arg v "${!key}" '.[$k] = $v' <<<"$vars")"
  done
  jq -c --argjson vars "$vars" '
    def expand: reduce ($vars | to_entries[]) as $v (.; gsub("\\$\\{" + $v.key + "\\}"; $v.value));
    .servers | to_entries[]
    | {name: .key, enabled: .value.enabled, config: (.value.config | walk(if type == "string" then expand else . end))}
  ' "$1"
}

claude_mcp() {
  local line name
  while IFS= read -r line; do
    name="$(jq -r .name <<<"$line")"
    claude mcp remove "$name" -s user > /dev/null 2>&1
    [ "$(jq -r .enabled <<<"$line")" = true ] || continue
    claude mcp add-json "$name" "$(jq -c .config <<<"$line")" -s user > /dev/null || echo "claude: $name falhou"
  done < <(mcp_lines "$1")
  echo "claude: mcp em dia"
}

codex_mcp() {
  local line name cfg how
  while IFS= read -r line; do
    name="$(jq -r .name <<<"$line")"; cfg="$(jq -c .config <<<"$line")"
    codex mcp remove "$name" > /dev/null 2>&1
    [ "$(jq -r .enabled <<<"$line")" = true ] || continue
    how=()
    if [ "$(jq -r '.url // empty' <<<"$cfg")" != "" ]; then
      how=(--url "$(jq -r .url <<<"$cfg")")
    else
      while IFS= read -r a; do how+=(--env "$a"); done < <(jq -r '(.env // {}) | to_entries[] | "\(.key)=\(.value)"' <<<"$cfg")
      how+=(--)
      while IFS= read -r a; do how+=("$a"); done < <(jq -r '[.command] + (.args // []) | .[]' <<<"$cfg")
    fi
    codex mcp add "$name" "${how[@]}" > /dev/null || echo "codex: $name falhou"
  done < <(mcp_lines "$1")
  echo "codex: mcp em dia"
}

# The whole file through jq, so the rest of it stays. A file with comments is the person's: jq cannot keep them.
opencode_mcp() {
  local dir="$config_home/opencode" file tmp
  file="$dir/opencode.json"
  if [ ! -f "$file" ] && [ -f "$dir/opencode.jsonc" ]; then
    echo "opencode: $dir/opencode.jsonc tem comentários, mcp não escrito"
    return 0
  fi
  mkdir -p "$dir"
  [ -f "$file" ] || echo '{"$schema": "https://opencode.ai/config.json"}' > "$file"
  jq -e . "$file" > /dev/null 2>&1 || { echo "opencode: $file não é JSON puro, mcp não escrito"; return 0; }
  tmp="$(mktemp "$file.XXXXXX")" || return 1
  if jq --slurpfile lines <(mcp_lines "$1") '
    def server:
      if (.url // "") != "" then {type: "remote", url} + (if (.headers // {}) == {} then {} else {headers} end)
      else {type: "local", command: ([.command] + (.args // []))}
        + (if (.env // {}) == {} then {} else {environment: .env} end) end;
    reduce $lines[] as $s (.;
      if $s.enabled then .mcp.servers[$s.name] = ($s.config | server)
      else del(.mcp.servers[$s.name]) end)' "$file" > "$tmp"; then
    mv "$tmp" "$file"
    echo "opencode: mcp em dia"
  else
    rm -f "$tmp"
    echo "opencode: catálogo inválido, mcp não escrito"
  fi
}

mcp() {
  local file="${1:?soul mcp <catalog> [--dry-run]}" line
  [ -f "$file" ] || die "catálogo não existe: $file"
  command -v jq > /dev/null || die "jq é preciso para ler o catálogo"
  if [ "${2:-}" = --dry-run ]; then
    mcp_lines "$file"
    return 0
  fi
  if command -v claude > /dev/null; then claude_mcp "$file"; fi
  if command -v opencode > /dev/null; then opencode_mcp "$file"; fi
  if command -v codex > /dev/null; then codex_mcp "$file"; fi
}

install_harnesses() {
  local skills=1 catalog=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-skills) skills=0; shift ;;
      --mcps) catalog="${2:-}"; shift 2 ;;
      *) die "soul install: não conheço $1" ;;
    esac
  done
  command -v jq > /dev/null || { echo "jq não encontrado: as outras CLIs ficam sem skills e sem mcp"; return 0; }
  if [ "$skills" = 1 ]; then install_skills; fi
  if [ -n "$catalog" ]; then mcp "$catalog"; fi
}

# A session that resumes, prints, runs a subcommand or asks for help gets no invoke first; the
# flags differ per CLI (-c continues in claude, sets config in codex).
wants_invoke() {
  [ "${MANDRAKE_INVOKE:-0}" = 1 ] || return 1
  local cli="$1" a; shift
  for a in "$@"; do
    case "$a" in -h | --help | --version) return 1 ;; esac
    case "$cli:$a" in
      claude:-p | claude:--print | claude:-c | claude:--continue | claude:-r | claude:--resume | claude:--resume=* | claude:-v) return 1 ;;
      codex:-V | codex:resume | codex:fork | codex:exec | codex:e | codex:review | codex:apply | codex:a) return 1 ;;
      opencode:-c | opencode:--continue | opencode:-s | opencode:--session | opencode:--prompt | opencode:-v) return 1 ;;
      opencode:run | opencode:session | opencode:serve | opencode:acp | opencode:mini) return 1 ;;
    esac
  done
}

launch() {
  local cli="$1" name="$2"; shift 2
  local file="$binds/prompt-$name.md" first=() first_text extra=() lines
  mkdir -p "$binds" || die "não consegui criar $binds"
  prompt "$name" > "$file"
  lines="$(env_lines "$name")" || exit 1
  eval "$lines"
  case "$cli" in
    claude)
      route
      [ -f "$souls/$name/settings.json" ] && extra=(--settings "$souls/$name/settings.json")
      extra+=(--system-prompt-file "$file" --name "$(printf '%s' "${name:0:1}" | tr '[:lower:]' '[:upper:]')${name:1}")
      wants_invoke claude "$@" && first=(/invoke)
      exec claude ${extra[@]+"${extra[@]}"} "$@" ${first[@]+"${first[@]}"} ;;
    codex)
      # The env set explicitly: codex drops variables named like *KEY* from commands by default, and
      # GIT_CONFIG_KEY_0 carries the signing key setting. TOML takes a JSON string as a basic string.
      local set="" k
      for k in $(printf '%s\n' "$lines" | sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p'); do
        set="$set${set:+,}$k=$(jq -n --arg v "${!k}" '$v')"
      done
      extra=(--no-daemon -c "developer_instructions=$(jq -Rs . < "$file")" -c "shell_environment_policy.set={$set}")
      if wants_invoke codex "$@" && first_text="$(render_skill invoke)"; then first=("$first_text"); fi
      exec codex "${extra[@]}" "$@" ${first[@]+"${first[@]}"} ;;
    opencode)
      local base="${OPENCODE_CONFIG_CONTENT:-}"
      [ -n "$base" ] || base='{}'
      # Its Claude models run Claude Code under this private server, which inherits the route.
      route
      OPENCODE_CONFIG_CONTENT="$(jq -c --arg f "$file" '.instructions = ((.instructions // []) + [$f])' <<<"$base")" \
        || die "OPENCODE_CONFIG_CONTENT não é JSON"
      export OPENCODE_CONFIG_CONTENT
      if wants_invoke opencode "$@" && first_text="$(render_skill invoke)"; then first=(--prompt "$first_text"); fi
      exec opencode --standalone "$@" ${first[@]+"${first[@]}"} ;;
    *) die "não sei abrir uma soul em $cli (claude, codex, opencode)" ;;
  esac
}

# --yolo, whatever the CLI: each one's own flag for running without approvals.
yolo() {
  case "$1" in
    claude) echo --dangerously-skip-permissions ;;
    codex) echo --dangerously-bypass-approvals-and-sandbox ;;
    opencode) echo --auto ;;
    *) echo --yolo ;;
  esac
}

run() {
  local cli="${1:?soul run <cli> [args...]}" a name="" want=0 rest=() y=""; shift
  for a in "$@"; do
    if [ "$want" = 1 ]; then
      name="$(resolve "$a")" || exit 1
      want=2
    elif [ "$want" = 0 ] && { [ "$a" = invoke ] || [ "$a" = /invoke ]; }; then
      want=1
    elif [ "$a" = --yolo ]; then
      y="$(yolo "$cli")"
    else
      rest+=("$a")
    fi
  done
  # opencode reads a subcommand's flags only after it (`opencode run --auto`); the others take it first.
  if [ -n "$y" ]; then
    case "$cli:${rest[0]:-}" in
      opencode:run) rest=("${rest[0]}" "$y" "${rest[@]:1}") ;;
      *) rest=("$y" ${rest[@]+"${rest[@]}"}) ;;
    esac
  fi
  case "$want" in
    1) die "$cli invoke: qual soul? ($(list))" ;;
    2) launch "$cli" "$name" ${rest[@]+"${rest[@]}"} ;;
  esac
  [ "$cli" = claude ] && route
  exec "$cli" ${rest[@]+"${rest[@]}"}
}

cmd="${1:-}"; shift || true
case "$cmd" in
  run) run "$@" ;;
  bind) bind "$@" ;;
  whoami) whoami_ "$@" ;;
  env) n="$(resolve "${1:?soul env <soul>}")" || exit 1; env_lines "$n" ;;
  prompt) n="$(resolve "${1:?soul prompt <soul>}")" || exit 1; prompt "$n" ;;
  resolve) resolve "${1:?soul resolve <name>}" ;;
  list) list ;;
  session) line="$(harness)" || die "fora de uma sessão de CLI (claude, opencode, codex)"
    id="$(root_session "${line#*$'\t'}")" || exit 1
    printf '%s\t%s\n' "${line%%$'\t'*}" "$id" ;;
  skill) n="${1:?soul skill <name> [args...]}"; shift
    render_skill "$n" "$@" || die "skill '$n' não existe em $claude_home/skills" ;;
  install) install_harnesses "$@" ;;
  mcp) mcp "$@" ;;
  *) sed -n '2,/^set /p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2 ;;
esac
