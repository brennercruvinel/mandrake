# https://editorconfig.org/
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{toml,yml,yaml,json,jsonl,ts,tsx,js,mjs,sh}]
indent_size = 2

[*.go]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Recorded evidence is kept byte for byte as the recorder wrote it.
[{*.svg,tool/tests/e2e/anina/logs/**}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
max_line_length = off

[Makefile]
indent_style = tab
